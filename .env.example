# Copy to .env and fill in. Never commit .env.

# Required: long random string (openssl rand -hex 32). Encrypts stored OJS API keys -
# if you lose or change it, every source's API key must be re-entered.
APP_SECRET_KEY=

# Public address of the resolver (no trailing slash)
PUBLIC_BASE_URL=https://doi-services.com
SITE_NAME="DOI Services"

# Production only (docker compose)
SITE_DOMAIN=doi-services.com
POSTGRES_PASSWORD=

# Off-site replica, e.g. Backblaze B2 (leave empty to disable)
S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
